meta {
  name: Get job
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/crawl/{{jobId}}
  body: none
  auth: none
}

tests {
  test("200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("job fields", function () {
    const b = res.getBody();
    expect(b.jobId).to.equal(bru.getVar("jobId"));
    expect(["QUEUED", "RUNNING", "DONE", "FAILED", "CANCELLED"]).to.include(b.status);
    expect(b).to.include.all.keys("createdAt", "startedAt", "finishedAt", "pagesFetched", "pagesSkipped",
      "pagesFailed", "contactsFound", "queueSize", "error");
    expect(b.createdAt).to.be.a("string");
  });
}
