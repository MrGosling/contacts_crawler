meta {
  name: maxDepth above 5 - 400
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/crawl
  body: json
  auth: none
}

body:json {
  { "urls": ["https://example.org/"], "maxDepth": 6 }
}

tests {
  test("400 Bad Request", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("ProblemDetail", function () {
    expect(res.getHeader("content-type")).to.contain("application/problem+json");
    expect(res.getBody().status).to.equal(400);
    expect(res.getBody().title).to.equal("Bad Request");
  });
}
