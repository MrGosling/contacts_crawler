meta {
  name: Clear REST seeds
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}/api/seeds
  body: none
  auth: none
}

docs {
  Удаляет только seed'ы, добавленные через REST; `crawler.seeds` и `seeds.txt` остаются.
}

tests {
  test("204 No Content", function () {
    expect(res.getStatus()).to.equal(204);
  });
}
